# Optional. Copy to .env for local builds, or set these in Cloudflare Pages
# (Settings, Environment variables). Leave them empty to hide the support panel.
# These values end up in the public page. Put nothing secret here.

# Your UPI ID, for example name@okaxis
VITE_UPI_ID=
# Name shown in the payer's UPI app
VITE_UPI_NAME=AsokaKrsna
# Your Buy Me a Coffee page, for example https://buymeacoffee.com/yourname
VITE_COFFEE_URL=
